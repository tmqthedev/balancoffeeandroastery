# ============================================
# BALAN COFFEE & ROASTERY - BACKEND CONFIG EXAMPLE
# ============================================
# Copy this file to .env and update with real secrets
# IMPORTANT: Never commit real secrets to git!

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB)
# MONGODB_URI=mongodb://localhost:27017/balancoffee_db
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Session Secret
SESSION_SECRET=your_session_secret_change_this_in_production

# Contact Payment Configuration
# No additional configuration needed for contact-based payments

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Backend URL
BACKEND_URL=http://localhost:5000

# AWS / Cognito / Secrets Manager Configuration
AWS_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=ap-southeast-1_example
COGNITO_CLIENT_ID=your_cognito_app_client_id
DATABASE_SECRET_ID=balan-coffee/dev/database
SMTP_SECRET_ID=balan-coffee/dev/smtp
COGNITO_SECRET_ID=balan-coffee/dev/cognito
AUTH_COOKIE_SECURE=false
