# Backend environment variables for Docker Compose and EC2.
# Copy to backend/.env and replace placeholders before deployment.

# Development defaults for local Docker
# NODE_ENV=development
# PORT=5000
# CORS_ORIGIN=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:5000

# Production placeholders for EC2 / RDS
NODE_ENV=development
PORT=5000
DATABASE_PROVIDER=postgres
POSTGRES_URI=postgresql://<username>:<password>@<rds-endpoint>:5432/balancoffee?sslmode=no-verify
POSTGRES_SSLMODE=no-verify
JWT_SECRET=<generate-a-long-random-production-secret>
JWT_EXPIRE=7d
# Local development
CORS_ORIGIN=http://localhost:5173
# Production example
# CORS_ORIGIN=https://yourdomain.com
FRONTEND_URL=http://<ec2-public-ip-or-domain>
BACKEND_URL=http://<ec2-public-ip-or-domain>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=<smtp-email-address>
EMAIL_PASSWORD=<smtp-app-password>

# Optional variables
# Comma-separated notification recipients for contact form emails.
ADMIN_EMAILS=admin1@example.com,admin2@example.com
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AWS / Cognito / Secrets Manager Configuration
AWS_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=ap-southeast-1_example
COGNITO_CLIENT_ID=your_cognito_app_client_id
DATABASE_SECRET_ID=balan-coffee/dev/database
SMTP_SECRET_ID=balan-coffee/dev/smtp
COGNITO_SECRET_ID=balan-coffee/dev/cognito
AUTH_COOKIE_SECURE=false
