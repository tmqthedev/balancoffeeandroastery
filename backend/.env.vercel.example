# ============================================
# VERCEL DEPLOYMENT ENVIRONMENT VARIABLES
# ============================================
# Copy these to your Vercel dashboard environment variables

# CRITICAL: Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/balancoffee?retryWrites=true&w=majority

# Server Configuration
NODE_ENV=production
PORT=5000

# Authentication Secrets (GENERATE NEW ONES FOR PRODUCTION)
JWT_SECRET=your_super_secure_jwt_secret_for_production_minimum_32_characters
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_super_secure_session_secret_for_production_minimum_32_characters

# Email Configuration (Optional - for contact forms)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_production_email@gmail.com
EMAIL_PASSWORD=your_production_app_password

# CORS Configuration (UPDATE WITH YOUR VERCEL FRONTEND URL)
CORS_ORIGIN=https://your-frontend-app.vercel.app

# File Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Vercel-specific (Automatically set by Vercel)
VERCEL=1
VERCEL_URL=automatically_set_by_vercel

# ============================================
# MONGODB ATLAS SETUP INSTRUCTIONS
# ============================================
# 1. Create MongoDB Atlas account at mongodb.com/atlas
# 2. Create new cluster (free tier available)
# 3. Create database user with read/write permissions
# 4. Add IP whitelist: 0.0.0.0/0 (allow all IPs for Vercel)
# 5. Get connection string and replace username/password
# 6. Update MONGODB_URI above with your connection string

# ============================================
# VERCEL DEPLOYMENT STEPS
# ============================================
# 1. Connect your GitHub repository to Vercel
# 2. Set Build Command: (leave empty)
# 3. Set Output Directory: (leave empty)
# 4. Add all environment variables above in Vercel dashboard
# 5. Deploy and test all API endpoints

# ============================================
# SECURITY NOTES
# ============================================
# - Never commit real secrets to git
# - Use strong, unique secrets for production
# - Regularly rotate secrets
# - Monitor database access logs
# - Enable MongoDB Atlas security features