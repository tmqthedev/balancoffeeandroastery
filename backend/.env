# Environment Configuration for Coffee E-commerce Backend

# Mock Database (set to true for development without real MSSQL)
USE_MOCK_DB=true

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration (Microsoft SQL Server)
DB_SERVER=localhost
DB_NAME=BalanCoffeeRoastery
DB_USER=sa
DB_PASSWORD=password123
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Configuration
JWT_SECRET=balan_coffee_super_secret_jwt_key_development_only
JWT_EXPIRE=7d

# Session Configuration
SESSION_SECRET=balan_coffee_session_secret_development_only

# OAuth Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/auth/facebook/callback

# Payment Gateway Configuration
# Momo
MOMO_PARTNER_CODE=MOMO_PARTNER_CODE
MOMO_ACCESS_KEY=MOMO_ACCESS_KEY
MOMO_SECRET_KEY=MOMO_SECRET_KEY
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/payment/result
MOMO_IPN_URL=http://localhost:5000/api/payments/momo/callback

# VNPay
VNPAY_TMN_CODE=VNPAY_TMN_CODE
VNPAY_SECRET_KEY=VNPAY_SECRET_KEY
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return

# Email Configuration (for order confirmations, contact forms)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@balancoffee.com

# File Upload Configuration
UPLOAD_PATH=uploads/

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
