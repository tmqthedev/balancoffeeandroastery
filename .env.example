# ============================================
# BALAN COFFEE & ROASTERY - FRONTEND CONFIG EXAMPLE
# ============================================
# Copy this file to .env and update values
# IMPORTANT: Only VITE_ variables are exposed to browser

# API Base URL
VITE_API_URL=http://localhost:5000/api

# App Configuration
VITE_APP_NAME=Balan Coffee & Roastery
VITE_APP_URL=http://localhost:3000

# Analytics IDs (optional)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_FACEBOOK_PIXEL_ID=your_facebook_pixel_id
VITE_TIKTOK_PIXEL_ID=your_tiktok_pixel_id
