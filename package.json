{
  "name": "balancoffeeandroastery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js",
    "dev:no-hmr": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js --config vite.config.no-hmr.js",
    "build": "vite build --config vite.config.prod.js",
    "build:dev": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "build:staging": "NODE_ENV=staging vite build --config vite.config.prod.js",
    "build:production": "NODE_ENV=production vite build --config vite.config.prod.js",
    "preview": "vite preview",
    "preview:network": "vite preview --host",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "clean:cache": "rimraf node_modules/.vite",
    "optimize": "npm run clean && npm run build:production",
    "size-check": "npm run build && bundlesize",
    "backend:dev": "cd backend && npm run dev",
    "backend:start": "cd backend && npm start",
    "backend:seed": "cd backend && npm run seed",
    "start:dev": "concurrently \"npm run backend:start\" \"npm run dev\"",
    "start:production": "concurrently \"npm run backend:start\" \"npm run preview\"",
    "deploy:build": "npm run optimize && cd backend && npm install --production",
    "performance:audit": "lighthouse http://localhost:4173 --output json --output html --output-path ./performance-audit",
    "bundle:report": "npm run build:analyze && open dist/stats.html"
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "axios": "^1.9.0",
    "mongodb": "^6.19.0",
    "postcss": "^8.5.4",
    "prop-types": "^15.8.1",
    "puppeteer": "^24.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.26.2",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "cssnano": "^7.0.7",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^24.0.0",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "terser": "^5.40.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
