# ============================================
# BALAN COFFEE & ROASTERY - FRONTEND CONFIG
# ============================================
# IMPORTANT: Only VITE_ variables are exposed to browser
# Never put secret keys here!

# API Base URL - PUBLIC
VITE_API_URL=http://localhost:5000/api

# App Configuration - PUBLIC
VITE_APP_NAME=Balan Coffee & Roastery
VITE_APP_URL=http://localhost:3000

# Analytics IDs - PUBLIC (replace with your actual IDs)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_FACEBOOK_PIXEL_ID=your_facebook_pixel_id # Disabled - Facebook Pixel removed
VITE_TIKTOK_PIXEL_ID=your_tiktok_pixel_id

# Payment Return URLs - PUBLIC
# VITE_MOMO_RETURN_URL=http://localhost:3000/payment/momo/return # Disabled - MoMo removed

# ============================================
# PRODUCTION OVERRIDES (uncomment for production)
# ============================================

# VITE_API_URL=https://yourdomain.com/api
# VITE_APP_URL=https://yourdomain.com
# VITE_MOMO_RETURN_URL=https://yourdomain.com/payment/momo/return # Disabled - MoMo removed
