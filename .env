# ============================================
# BALAN COFFEE & ROASTERY - ENVIRONMENT CONFIG
# ============================================

# ============================================
# FRONTEND CONFIGURATION
# ============================================

# Facebook App ID for SDK - Get this from https://developers.facebook.com
# Important: Replace with your actual Facebook App ID
VITE_FACEBOOK_APP_ID=your_facebook_app_id_here

# API Base URL
VITE_API_URL=http://localhost:5000/api

# App Configuration
VITE_APP_NAME=Balan Coffee & Roastery
VITE_APP_URL=http://localhost:3000

# Analytics (optional - replace with your actual IDs)
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_FACEBOOK_PIXEL_ID=your_facebook_pixel_id
VITE_TIKTOK_PIXEL_ID=your_tiktok_pixel_id

# Payment Return URLs
VITE_MOMO_RETURN_URL=http://localhost:3000/payment/momo/return
VITE_VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay/return

# ============================================
# BACKEND CONFIGURATION
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=1433
DB_NAME=balancoffee_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# Payment Configuration
# MoMo Payment
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# VNPay Configuration
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_SECRET_KEY=your_vnpay_secret_key
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Session Configuration
SESSION_SECRET=your_session_secret_change_this_in_production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# PRODUCTION OVERRIDES (uncomment for production)
# ============================================

# NODE_ENV=production
# VITE_API_URL=https://yourdomain.com/api
# VITE_APP_URL=https://yourdomain.com
# FACEBOOK_CALLBACK_URL=https://yourdomain.com/api/auth/facebook/callback
# CORS_ORIGIN=https://yourdomain.com
# MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
# VNPAY_URL=https://vnpayment.vn/paymentv2/vpcpay.html
