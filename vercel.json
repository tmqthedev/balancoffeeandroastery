{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "backend/server.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server"
    },
    {
      "source": "/health",
      "destination": "/backend/server"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/backend/server"
    }
  ]
}